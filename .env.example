# Copy to .env
DATABASE_URL="file:./prisma/dev.db"
# Postgres switch (also change provider in prisma/schema.prisma to "postgresql"):
# DATABASE_URL="postgresql://fsm:fsm_secret@localhost:5432/fsm?schema=public"
NEXT_PUBLIC_APP_NAME="FieldOps FSM"
DEMO_TENANT_SLUG="demo-casablanca"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# --- Notifications mail (optionnel) ---
# Sans SMTP: les emails sont affichés dans les logs serveur + tracés sur le ticket.
# Avec SMTP (ex: Gmail App Password, SendGrid, OVH):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FieldOps <no-reply@fieldops.ma>"

# --- Basacore identity gateway (optionnel) ---
# Sans CLIENT_ID/CLIENT_SECRET, le bouton "Continuer avec Basacore" est masqué.
# Créez un login client dans Basacore Console > Products > <produit> > Integration.
BASACORE_ISSUER="http://localhost:8000"
BASACORE_CLIENT_ID=""
BASACORE_CLIENT_SECRET=""
# Tenant Basacore envoyé en hint sur /authorize.
BASACORE_TENANT_HINT=""
# Mapping tenant Basacore -> tenant local, ex: "northwind-sales=demo-casablanca".
BASACORE_TENANT_MAP=""


# --- AI Agent Factory dispatch (optionnel) ---
# URL of the AI Factory API, the published dispatch agent id, and a customer
# gateway key with agents:run scope. Without these the dispatcher falls back to
# the deterministic ranking in src/lib/dispatch.ts.
FACTORY_GATEWAY_URL="http://localhost:8080"
FACTORY_WEB_URL="http://localhost:3100"
FACTORY_AGENT_ID=""
FACTORY_AGENT_KEY=""

# Shared secret the factory agent uses to call /api/agents/dispatch-context.
# Generate with: openssl rand -base64 32
AGENT_CONTEXT_SECRET=""
